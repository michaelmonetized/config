{
   "action": {
      "default_title": "Superhuman Mail"
   },
   "background": {
      "service_worker": "background/background_page.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "pages/index.js" ],
      "matches": [ "https://mail.superhuman.com/**" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "pages/foreground_cache_manager.js" ],
      "matches": [ "https://mail.superhuman.com/~backend/build/foreground_cache_manager2.html" ],
      "run_at": "document_start"
   }, {
      "js": [ "provider_web_code/index.js" ],
      "matches": [ "https://mail.google.com/*", "https://calendar.google.com/*", "https://outlook.live.com/mail/*", "https://outlook.office.com/mail/*", "https://outlook.office365.com/mail/*", "https://outlook.cloud.microsoft/mail/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "google/index.js" ],
      "match_about_blank": true,
      "matches": [ "https://*.google.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "hubspot/index.js" ],
      "matches": [ "https://app.hubspot.com/object-builder/*/0-1/embed?source=sh-open*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "all/index.js" ],
      "match_about_blank": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   }, {
      "js": [ "pages/index.js" ],
      "matches": [ "https://superhuman.com/**", "https://pp-sh.io/*", "https://*.pp-sh.io/*", "https://qa-sh.io/*", "https://*.qa-sh.io/*", "https://settings.superhuman.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
   },
   "description": "The most productive email app ever made.",
   "externally_connectable": {
      "matches": [ "https://mail.superhuman.com/*" ]
   },
   "homepage_url": "https://superhuman.com",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "icons/256x256.png",
      "16": "icons/32x32.png",
      "19": "icons/38x38.png",
      "32": "icons/32x32.png",
      "38": "icons/38x38.png",
      "48": "icons/96x96.png",
      "96": "icons/96x96.png"
   },
   "incognito": "not_allowed",
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "114",
   "name": "Superhuman Mail",
   "permissions": [ "alarms", "background", "gcm", "notifications", "storage", "system.cpu", "system.display", "system.memory", "tabs", "unlimitedStorage", "offscreen", "scripting" ],
   "short_name": "Superhuman",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.1.60529.1906",
   "web_accessible_resources": [ {
      "matches": [ "https://mail.google.com/*", "https://mail.superhuman.com/*" ],
      "resources": [ "128.png", "frame.html", "superhuman.html" ]
   } ]
}
