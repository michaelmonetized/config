  "content": "import { v } from \"convex/values\";\nimport { mutation, query } from \"./_generated/server\";\nimport { z } from \"zod\";\nimport { Id } from \"./_generated/dataModel\";\n\nexport const ContactTable = {\n  name: v.string(),\n  phone: v.string(),\n  email: v.string(),\n  message: v.optional(v.string()),\n  page: v.string(),\n  created: v.number(), // Server-side timestamp\n};\n\nexport const ContactValidator = z.object({\n  name: z.string().min(1, { message: \"Name is required\" }),\n  phone: z\n    .string()\n    .min(10, { message: \"10 digit phone number is required\" })\n    .max(10, { message: \"10 digit phone number is required\" }),\n  email: z.string().email({ message: \"Invalid email address\" }).min(1, {\n    message: \"Email is required\",\n  }),\n  message: z.string().optional(),\n  page: z.string(),\n  created: z.number(), // Server-side timestamp\n});\n\nexport type Contact = z.infer<typeof ContactValidator>;\n\nexport const createContact = mutation({\n  args: {\n    name: v.string(),\n    phone: v.string(),\n    email: v.string(),\n    message: v.optional(v.string()),\n    page: v.string(),\n  },\n\n  handler: async (ctx, args) => {\n    const contactId = await ctx.db.insert(\"contacts\", {\n      ...args,\n      created: Date.now(), // Server-side timestamp\n    });\n    return contactId;\n  },\n});\n\nexport const getContacts = query({\n  args: {},\n\n  handler: async (ctx) => {\n    return await ctx.db.query(\"contacts\").collect();\n  },\n});\n\nexport const searchContacts = query({\n  args: {\n    query: v.string(),\n  },\n\n  handler: async (ctx, args) => {\n    return await ctx.db\n      .query(\"contacts\")\n      .withSearchIndex(\"search_contacts\", (q) => q.search(\"name\", args.query))\n      .collect();\n  },\n});\n\nexport const getContactBy = query({\n  args: {\n    field: v.union(\n      v.literal(\"name\"),\n      v.literal(\"phone\"),\n      v.literal(\"email\"),\n      v.literal(\"created\"),\n      v.literal(\"page\"),\n      v.literal(\"id\"),\n      v.literal(\"_creationTime\")\n    ),\n    value: v.string(),\n  },\n\n  handler: async (ctx, args) => {\n    let result = null;\n\n    switch (args.field) {\n      case \"name\":\n        result = await ctx.db\n          .query(\"contacts\")\n          .withIndex(\"by_name\", (q) => q.eq(\"name\", args.value))\n          .first();\n        break;\n      case \"phone\":\n        result = await ctx.db\n          .query(\"contacts\")\n          .withIndex(\"by_phone\", (q) => q.eq(\"phone\", args.value))\n          .first();\n        break;\n      case \"email\":\n        result = await ctx.db\n          .query(\"contacts\")\n          .withIndex(\"by_email\", (q) => q.eq(\"email\", args.value))\n          .first();\n        break;\n      case \"created\":\n        result = await ctx.db\n          .query(\"contacts\")\n          .filter((q) => q.eq(q.field(\"_creationTime\"), parseInt(args.value)))\n          .collect();\n        break;\n      case \"page\":\n        result = await ctx.db\n          .query(\"contacts\")\n          .withIndex(\"by_page\", (q) => q.eq(\"page\", args.value))\n          .first();\n        break;\n      case \"id\":\n        result = await ctx.db.get(args.value as Id<\"contacts\">);\n        break;\n    }\n\n    return result;\n  },\n});\n\nexport const editContact = mutation({\n  args: { ...ContactTable, id: v.string() },\n  handler: async (ctx, args) => {\n    return await ctx.db.patch(args.id as Id<\"contacts\">, args);\n  },\n});\n\nexport const delContact = mutation({\n  args: { id: v.string() },\n  handler: async (ctx, args) => {\n    return await ctx.db.delete(args.id as Id<\"contacts\">);\n  },\n});\n\nexport const deleteContact = mutation({\n  args: { id: v.id(\"contacts\") },\n  handler: async (ctx, args) => {\n    return await ctx.db.delete(args.id);\n  },\n});\n\n",
