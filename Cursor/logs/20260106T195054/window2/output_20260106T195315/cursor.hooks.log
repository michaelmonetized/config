ring()),\n        variance: v.optional(v.string()),\n        laborCost: v.optional(v.string()),\n        lySales: v.optional(v.string()),\n        goalVariance: v.optional(v.string()),\n      })\n    ),\n    year: v.optional(v.number()), // Fallback if year not in rows\n  },\n  handler: async (ctx, args) => {\n    let imported = 0;\n\n    for (let i = 0; i < args.rows.length; i++) {\n      const row = args.rows[i];\n\n      // Determine if this is a goal or total row based on period text only\n      const isGoal = row.period === \"Goals\";\n      const isTotal = row.period === \"Totals\";\n\n      // Skip goal/total rows for now\n      if (isGoal || isTotal) continue;\n\n      const period = parseNumber(row.period);\n      if (!period) continue;\n\n      // Use year from row if available, otherwise use args.year, fallback to current year\n      const year =\n        (row.year ? parseNumber(row.year) : null) ??\n        args.year ??\n        new Date().getFullYear();\n      if (!year) continue;\n\n      const existing = await ctx.db\n        .query(\"metricsPeriodic\")\n        .withIndex(\"by_year_period\", (q) =>\n          q.eq(\"year\", year).eq(\"period\", period)\n        )\n        .first();\n\n      const data = {\n        year,\n        period,\n        isGoal: false,\n        isTotal: false,\n        sales: parseCurrency(row.sales),\n        transactions: parseNumber(row.transactions),\n        guests: parseNumber(row.guests),\n        cogs: parsePercentage(row.cogs),\n        labor: parsePercentage(row.labor),\n        laborCost: parseCurrency(row.laborCost),\n        profitLoss: parsePercentage(row.profitLoss),\n        sos: parseNumber(row.sos),\n        smgSOS: parsePercentage(row.smgSOS),\n        smgOSAT: parsePercentage(row.smgOSAT),\n        bin: parsePercentage(row.bin),\n        variance: parsePercentage(row.variance),\n        lySales: parseCurrency(row.lySales),\n        goalVariance: parsePercentage(row.goalVariance),\n      };\n\n      if (existing) {\n        await ctx.db.patch(existing._id, data);\n      } else {\n        await ctx.db.insert(\"metricsPeriodic\", data);\n      }\n      imported++;\n    }\n\n    return { imported };\n  },\n});\n\n// ============================================================================\n// UTILITY QUERIES\n// ============================================================================\n\nexport const getLatestDailyDate = query({\n  args: {},\n  handler: async (ctx) => {\n    const latest = await ctx.db\n      .query(\"metricsDaily\")\n      .withIndex(\"by_date\")\n      .order(\"desc\")\n      .first();\n\n    return latest?.date ?? null;\n  },\n});\n\nexport const getOldestDailyDate = query({\n  args: {},\n  handler: async (ctx) => {\n    const oldest = await ctx.db\n      .query(\"metricsDaily\")\n      .withIndex(\"by_date\")\n      .order(\"asc\")\n      .first();\n\n    return oldest?.date ?? null;\n  },\n});\n",
